# .env.example
# 이 파일을 복사해서 .env로 이름 바꾸고 실제 값을 채우세요:
#   cp .env.example .env   (PowerShell: copy .env.example .env)
# .env는 .gitignore에 있어서 git에 올라가지 않습니다 — 각자 자기 키로 채우면 됩니다.

# --- MongoDB ---
# 로컬 docker-compose로 실행하면 이 값 그대로 써도 됩니다(컨테이너 내부 네트워크 이름).
# 호스트(도커 밖)에서 직접 스크립트를 실행할 땐 대신
#   MONGODB_URI=mongodb://localhost:27017
# 로 그때그때 덮어써야 합니다(예: PowerShell `$env:MONGODB_URI = 'mongodb://localhost:27017'`).
MONGODB_URI=mongodb://mongo:27017
# 코드에서 현재 직접 참조하지는 않지만(DB 이름은 config_cilent.py에 "mimori"로 고정돼 있음)
# .env 구조를 맞추기 위해 남겨둠.
MONGODB_DB=mimori

# --- Qdrant ---
# 로컬 docker-compose 기본값. 호스트에서 Qdrant 대시보드 등에 직접 붙으려면
# docker-compose.yml에 매핑된 호스트 포트(기본 16333, Windows 예약 포트 회피용)를 쓰세요.
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- 관리자 API 인증 (api/routes.py의 hide/unhide/완전삭제/admin stats) ---
# 비워두면 관리자 엔드포인트가 전부 401로 막힌다(fail-closed). 프론트 /admin
# 페이지에서 여기 넣은 값을 그대로 입력해야 관리 기능이 동작한다.
ADMIN_API_KEY=

# --- Tavily (크롤링) ---
# https://tavily.com 에서 발급
TAVILY_API_KEY=

# --- YouTube Data API v3 (크롤링) ---
# https://console.cloud.google.com 에서 발급, YouTube Data API v3 활성화 필요.
# 일일 쿼터가 있으니(검색 1회당 약 100 unit) 주의.
YOUTUBE_API_KEY=

# --- 네이버 데이터랩 (트렌드 판정, 1차 신호) ---
# https://developers.naver.com 에서 애플리케이션 등록 후 발급 (검색어 트렌드 API)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 카카오 (트렌드 판정, 2차 신호: 블로그/카페 언급량) ---
# https://developers.kakao.com 에서 애플리케이션 등록 후 REST API 키 발급
KAKAO_REST_API_KEY=

# --- NVIDIA NIM (LLM 분석, analysis/pipeline.py) ---
NIM_KEY=

# 코드에서 현재 직접 참조하지는 않지만 .env 구조를 맞추기 위해 남겨둠.
ENV=development
